# Copy this file to .env for local development. Never commit real secrets.

# Server-only secret for future backend/serverless OpenAI usage.
# Do NOT expose this in Vite client code or rename it with a VITE_ prefix.
OPENAI_API_KEY=your-openai-api-key-here

# Public client runtime values are bundled into the browser build.
# Only put non-secret values behind the VITE_ prefix.
VITE_OPENAI_PROXY_URL=https://example.com/api/openai
VITE_ENABLE_OPENAI_UI=false
